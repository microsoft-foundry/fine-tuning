# Required Foundry project endpoint. Do not commit the populated .env file.
FOUNDRY_PROJECT_ENDPOINT=

# Enable only for a cookbook whose metadata explicitly requires preview APIs.
FOUNDRY_ALLOW_PREVIEW=

# Keep browser authentication excluded in notebooks by default. Run `az login`
# or use another supported DefaultAzureCredential source.
FOUNDRY_EXCLUDE_INTERACTIVE_BROWSER_CREDENTIAL=
FOUNDRY_CREDENTIAL_PROCESS_TIMEOUT_SECONDS=

# Running a notebook's upload or training cell is the explicit operation boundary.

# Demo-specific model/deployment values belong in the demo's .env documentation.
# No resource, region, tenant, subscription, API key, or job identifier is stored here.
