# Configure your own project and HTTPS tool endpoint. Do not commit .env.
FOUNDRY_PROJECT_ENDPOINT=
RFT_TOOL_SERVER_URL=
# Optional shared secret: inject the SAME high-entropy value into the hosted
# catalog server and the notebook environment (or local ignored .env).
# The notebook sends it in Authorization headers, never in the URL or saved method.
FOUNDRY_TOOL_AUTH_TOKEN=
# Recovery only: after reconciling a pending job POST in Foundry, set its verified ID.
# This does not authorize a new submission or bypass project/recipe/file checks.
FOUNDRY_RECONCILED_TOOL_RFT_JOB_ID=
