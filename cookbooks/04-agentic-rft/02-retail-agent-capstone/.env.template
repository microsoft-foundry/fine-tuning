# Required for optional Microsoft Foundry file, evaluation, agent, or fine-tuning operations.
FOUNDRY_PROJECT_ENDPOINT=

# Required for optional base-model or fine-tuned-model inference.
FOUNDRY_MODEL_NAME=
FOUNDRY_SFT_BASE_MODEL=
FOUNDRY_RFT_BASE_MODEL=
FOUNDRY_RFT_GRADER_MODEL=

# Required for optional live MCP integration. Use the remote server's HTTPS MCP URL.
FOUNDRY_MCP_SERVER_URL=

# Required for optional RFT rollouts against individually hosted HTTP tools.
FOUNDRY_TOOLS_SERVER_URL=

# Optional authentication material for the remote MCP/tool server. Never commit values.
FOUNDRY_MCP_AUTH_TOKEN=
FOUNDRY_TOOLS_AUTH_TOKEN=

# Optional existing deployment names used only for explicitly enabled comparisons.
FOUNDRY_SFT_MODEL_NAME=
FOUNDRY_RFT_MODEL_NAME=

# Optional existing jobs to reuse/monitor instead of submitting new paid jobs.
FOUNDRY_SFT_JOB_ID=
FOUNDRY_RFT_JOB_ID=

# Select exact live generated SFT output instead of preserved curated SFT splits.
# When true, both paths are required, validated, and used directly for upload.
FOUNDRY_USE_LIVE_GENERATED_OUTPUT=
FOUNDRY_LIVE_GENERATED_TRAIN_PATH=
FOUNDRY_LIVE_GENERATED_VALIDATION_PATH=

# Offline-safe execution gates. Empty values are treated as false.
FOUNDRY_RUN_PAID_SFT=
FOUNDRY_RUN_PAID_RFT=
FOUNDRY_RUN_LIVE_EVALUATION=

# Bounded polling controls.
FOUNDRY_FILE_TIMEOUT_SECONDS=
FOUNDRY_JOB_TIMEOUT_SECONDS=
FOUNDRY_POLL_INTERVAL_SECONDS=
FOUNDRY_EVALUATION_LIMIT=
