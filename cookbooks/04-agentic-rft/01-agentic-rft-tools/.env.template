# Required: Microsoft Foundry project endpoint for the project that owns files and fine-tuning jobs.
FOUNDRY_PROJECT_ENDPOINT=

# Required only for live tool-contract checks or an explicitly enabled training submission.
FOUNDRY_TOOL_SERVER_URL=

# Optional: function key expected by the tool server. Never commit the value.
FOUNDRY_TOOL_AUTH_TOKEN=

# Required only if you deliberately submit a job after reviewing the generated payload.
FOUNDRY_RFT_BASE_MODEL=

# Existing deployment that serves the succeeded fine-tuned model. The current SDK
# supports deployment discovery but not creation, so create it through your approved
# management path before enabling invocation.
FOUNDRY_RFT_DEPLOYMENT=

# Optional existing job to reuse/monitor instead of creating a new paid job.
FOUNDRY_RFT_JOB_ID=

# Offline-safe execution gates. Empty values are treated as false.
FOUNDRY_RUN_REMOTE_TOOL_CHECK=
FOUNDRY_RUN_PAID_JOBS=
FOUNDRY_RUN_LIVE_EVALUATION=

# Bounded polling controls.
FOUNDRY_FILE_TIMEOUT_SECONDS=
FOUNDRY_JOB_TIMEOUT_SECONDS=
FOUNDRY_POLL_INTERVAL_SECONDS=
FOUNDRY_EVALUATION_LIMIT=
