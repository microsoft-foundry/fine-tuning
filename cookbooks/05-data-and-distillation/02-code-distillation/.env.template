# Copy to .env and provide values for your Foundry project.
# This template intentionally contains descriptions and empty values only.

# Foundry project endpoint.
FOUNDRY_PROJECT_ENDPOINT=
# Teacher model deployment name.
FOUNDRY_TEACHER_DEPLOYMENT=
# Base student deployment name.
FOUNDRY_STUDENT_DEPLOYMENT=
# Independent evaluator deployment name.
FOUNDRY_EVALUATOR_DEPLOYMENT=
# Fine-tunable student model identifier.
FOUNDRY_STUDENT_MODEL=
# Hosted code-interpreter capable deployment used only for secondary sandbox checks.
FOUNDRY_SANDBOX_MODEL=
# Exact historical parity request size. Primary parity mode requires 2000.
FOUNDRY_NUM_RECORDS=
# Exact historical parity training size. Primary parity mode requires 1500.
FOUNDRY_TRAIN_RECORDS=
# Exact held-out validation/evaluation size. Primary parity mode requires 84.
FOUNDRY_EVALUATION_RECORDS=
# Original four-dimension average threshold. Primary parity mode requires 3.0.
FOUNDRY_QUALITY_THRESHOLD=
# Maximum seconds to wait for each uploaded file to reach processed.
FOUNDRY_FILE_TIMEOUT_SECONDS=
# Maximum seconds to wait for a fine-tuning job to reach a terminal state.
FOUNDRY_JOB_TIMEOUT_SECONDS=
# Polling interval in seconds for upload and fine-tuning status.
FOUNDRY_POLL_INTERVAL_SECONDS=
# Parallelism for the 84-row teacher/base/fine-tuned primary evaluation.
FOUNDRY_EVALUATION_WORKERS=
# Transport concurrency for live generation; 12 balances quota and token lifetime.
FOUNDRY_GENERATION_PARALLELISM=
# Optional exact generated-output directory for hash-verified resume after a later-stage failure.
FOUNDRY_RESUME_OUTPUT=
