# Copy to .env and provide values for your Foundry project.
# This template intentionally contains descriptions and empty values only.

# Foundry project endpoint used by the notebook.
FOUNDRY_PROJECT_ENDPOINT=
# Comma-separated Foundry project endpoints in preferred failover order for live_validate.py.
FOUNDRY_PROJECT_ENDPOINTS=
# Teacher model deployment name.
FOUNDRY_TEACHER_DEPLOYMENT=
# Base student deployment name.
FOUNDRY_STUDENT_DEPLOYMENT=
# Independent evaluator deployment name.
FOUNDRY_EVALUATOR_DEPLOYMENT=
# Fine-tunable student model identifier.
FOUNDRY_STUDENT_MODEL=
# Existing deployment of the completed fine-tuned model.
FOUNDRY_FINE_TUNED_DEPLOYMENT=
# Azure subscription containing the selected Foundry resource.
FOUNDRY_SUBSCRIPTION_ID=
# Resource group containing the selected Foundry resource.
FOUNDRY_RESOURCE_GROUP=
# Deployment SKU used when creating the completed fine-tuned deployment.
FOUNDRY_DEPLOYMENT_SKU=
# Deployment capacity used when creating the completed fine-tuned deployment.
FOUNDRY_DEPLOYMENT_CAPACITY=
# Optional Foundry portal resource identifier used to construct a job link.
FOUNDRY_PORTAL_RESOURCE_ID=
# Optional Foundry portal account name when it differs from the regional endpoint account.
FOUNDRY_PORTAL_ACCOUNT_NAME=
# Number of source questions selected for a bounded live validation run.
FOUNDRY_SOURCE_COUNT=
# Opt in to live held-out inference and evaluator calls.
FOUNDRY_RUN_LIVE_EVALUATION=
# Opt in to teacher inference that creates the training dataset.
FOUNDRY_RUN_LIVE_GENERATION=
# Opt in to submitting a paid fine-tuning job.
FOUNDRY_RUN_PAID_JOBS=
# Maximum seconds to wait for each uploaded file to reach processed.
FOUNDRY_FILE_TIMEOUT_SECONDS=
# Maximum seconds to wait for a fine-tuning job to reach a terminal state.
FOUNDRY_JOB_TIMEOUT_SECONDS=
# Polling interval in seconds for upload and fine-tuning status.
FOUNDRY_POLL_INTERVAL_SECONDS=
