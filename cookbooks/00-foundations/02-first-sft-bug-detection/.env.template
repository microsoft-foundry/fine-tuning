# Microsoft Foundry project endpoint used by AIProjectClient
FOUNDRY_PROJECT_ENDPOINT=

# Existing base-model project deployment used for the pre-training baseline
FOUNDRY_BASE_DEPLOYMENT=

# Versioned model identifier supported for supervised fine-tuning in the selected project
FOUNDRY_BASE_MODEL=

# Project deployment used to judge bug-identification, explanation, and fix quality
FOUNDRY_JUDGE_DEPLOYMENT=

# Optional project file IDs; set both to reuse previously uploaded preserved datasets
FOUNDRY_EXISTING_TRAINING_FILE_ID=
FOUNDRY_EXISTING_VALIDATION_FILE_ID=

# Optional succeeded fine-tuning job ID used to skip paid job creation
FOUNDRY_EXISTING_FINE_TUNE_JOB_ID=

# Optional existing project deployment serving the fine-tuned model
FOUNDRY_FINE_TUNED_DEPLOYMENT=

# Explicit paid-operation gate; accepted values are true, false, or blank
FOUNDRY_RUN_PAID_JOBS=

# Explicit live-inference/evaluation gate; accepted values are true, false, or blank
FOUNDRY_RUN_LIVE_EVALUATION=

# Explicit deployment-creation gate; accepted values are true, false, or blank
FOUNDRY_CREATE_DEPLOYMENT=

# Azure management context required only when deployment creation is enabled
FOUNDRY_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_DEPLOYMENT_SKU=
FOUNDRY_DEPLOYMENT_CAPACITY=

# Cleanup gate for a deployment created by this notebook; accepted values are true, false, or blank
FOUNDRY_DELETE_CREATED_DEPLOYMENT=
