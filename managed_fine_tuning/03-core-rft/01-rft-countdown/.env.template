# Configure your own Foundry project. Authenticate with az login; no API key.
FOUNDRY_PROJECT_ENDPOINT=
# Required for the grader deployment quota and ARM operations.
FOUNDRY_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_RESOURCE_LOCATION=
# Optional display label, for example East US 2.
FOUNDRY_REGION=

# Optional deployment name; blank defaults to gpt-5.4-mini.
FOUNDRY_GRADER_DEPLOYMENT=
# Blank defaults to max. Alternatively, set an explicit capacity-unit limit.
# The resulting deployment must provide at least 100K TPM.
FOUNDRY_GRADER_CAPACITY=
# Blank defaults to 100000 TPM.
FOUNDRY_GRADER_MIN_TPM=
# Set true only after reviewing the notebook's printed deployment plan.
FOUNDRY_ALLOW_GRADER_DEPLOYMENT_UPDATE=
